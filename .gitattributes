# 텍스트 파일은 저장소에 LF로 저장한다.
* text=auto

# 소스 파일은 LF를 강제한다.
*.c   text eol=lf
*.h   text eol=lf
Makefile text eol=lf

# 설정/문서 파일
*.sh            text eol=lf
*.ps1           text eol=lf
*.sql           text eol=lf
*.schema        text eol=lf
*.md            text eol=lf
*.gitignore     text eol=lf
*.gitattributes text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
dockerfile      text eol=lf

# 바이너리 파일은 줄바꿈 변환을 하지 않는다.
*.dat binary
*.exe binary
*.o   binary
*.a   binary
*.lib binary
*.dll binary
*.png binary
*.jpg binary
*.pdf binary
